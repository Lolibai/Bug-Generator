# Copy to .env and adjust. Used by docker-compose and `node server/index.js`.

# Port the app is published on (host side).
PORT=3000

# Only needed when running the server OUTSIDE docker-compose
# (compose overrides this to point at the mongo service).
MONGODB_URI=mongodb://localhost:27017/bugreports

# Optional server-side Jira fallbacks for the /api/jira proxy.
# The browser-supplied credentials always take precedence.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional — enables POST /api/analytics/categorize (AI bug categorization).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Alternative server AI key (used when OPENROUTER_API_KEY is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Whisper dictation (whisper container).
# large-v3-turbo = fast, near-large-v3 quality. Use large-v3 for max accuracy.
WHISPER_MODEL=large-v3-turbo
# auto = GPU when available, CPU otherwise (Macs run CPU — that's fine).
WHISPER_DEVICE=auto
# NVIDIA GPU hosts: uncomment to enable GPU passthrough (needs nvidia-container-toolkit).
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Your machine's LAN IP — shown in the app as the phone-access address.
# Find it with: hostname -I | awk '{print $1}'   (docker cannot autodetect it)
HOST_IP=
